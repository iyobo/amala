{
  "name": "amala",
  "version": "10.0.9",
  "description": "A decorator-based TypeScript framework for building Koa APIs with validation, versioning, and OpenAPI support.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "keywords": [
    "koa",
    "router",
    "typescript",
    "controller",
    "rest",
    "api",
    "versioning",
    "openapi 3",
    "oas3"
  ],
  "repository": {
    "type": "github",
    "url": "https://github.com/iyobo/amala"
  },
  "homepage": "https://amalajs.com",
  "bugs": {
    "url": "https://github.com/iyobo/amala/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "test": "jest --config jestconfig.json",
    "test:watch": "jest --config jestconfig.json --watch",
    "build": "tsc",
    "prepublishOnly": "npm run build && npm test",
    "dev": "tsc -w",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx",
    "lint:fix": "eslint . --ext .js,.jsx,.ts,.tsx --fix",
    "changelog": "auto-changelog -p",
    "release:patch": "npm test && tsc && npm version patch && npm run changelog && git add CHANGELOG.md && git commit -m \"Release\" && npm publish && git push origin master --tags",
    "release:minor": "npm test && tsc && npm version minor && npm run changelog && git add CHANGELOG.md && git commit -m \"Release\" && npm publish && git push origin master --tags",
    "release:major": "npm test && tsc && npm version major && npm run changelog && git add CHANGELOG.md && git commit -m \"Release\" && npm publish && git push origin master--tags"
  },
  "files": [
    "dist/**/*",
    "!dist/tests/**/*"
  ],
  "author": "Iyobo Eki",
  "license": "MIT",
  "dependencies": {
    "@hapi/boom": "^10.0.1",
    "@koa/cors": "^5.0.0",
    "@koa/router": "^12.0.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.4",
    "helmet": "^8.3.0",
    "koa": "^2.16.4",
    "koa-body": "^4.2.0",
    "koa-helmet": "^9.0.0",
    "koa2-swagger-ui": "^5.12.0",
    "lodash": "^4.18.1",
    "openapi-types": "^12.1.3",
    "reflect-metadata": "^0.2.2"
  },
  "devDependencies": {
    "@koa/multer": "^4.0.0",
    "@types/boom": "^7.3.0",
    "@types/cookies": "^0.9.2",
    "@types/express": "^4.17.25",
    "@types/jest": "^29.5.14",
    "@types/koa": "^2.15.0",
    "@types/koa__cors": "^4.0.2",
    "@types/koa__router": "^12.0.3",
    "@types/lodash": "^4.14.149",
    "@types/node": "^26.4.0",
    "@types/supertest": "^7.2.0",
    "@typescript-eslint/eslint-plugin": "^5.9.0",
    "@typescript-eslint/parser": "^5.9.0",
    "auto-changelog": "^2.4.0",
    "eslint": "7.29.0",
    "eslint-config-prettier": "8.3.0",
    "eslint-config-standard": "16.0.3",
    "eslint-plugin-import": "2.23.4",
    "eslint-plugin-node": "11.1.0",
    "eslint-plugin-prettier": "3.4.0",
    "eslint-plugin-promise": "5.1.0",
    "eslint-plugin-react": "7.24.0",
    "eslint-plugin-standard": "5.0.0",
    "jest": "^29.7.0",
    "multer": "^2.3.0",
    "prettier": "^2.8.8",
    "supertest": "^7.2.2",
    "ts-jest": "^29.1.1",
    "ts-morph": "^13.0.3",
    "ts-node": "^10.9.1",
    "typescript": "^5.1",
    "typescript-eslint": "0.0.1-alpha.0"
  }
}
