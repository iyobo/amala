{
  "name": "amala",
  "version": "10.0.9",
  "description": "A decorator-based TypeScript framework for building Koa APIs with validation, versioning, and OpenAPI support.",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "keywords": [
    "koa",
    "router",
    "typescript",
    "controller",
    "rest",
    "api",
    "versioning",
    "openapi 3",
    "oas3"
  ],
  "repository": {
    "type": "github",
    "url": "git+https://github.com/iyobo/amala.git"
  },
  "homepage": "https://amalajs.com",
  "bugs": {
    "url": "https://github.com/iyobo/amala/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "test": "jest --config jestconfig.json",
    "test:watch": "jest --config jestconfig.json --watch",
    "build": "tsc",
    "prepublishOnly": "npm run build && npm test",
    "dev": "tsc -w",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx",
    "lint:fix": "eslint . --ext .js,.jsx,.ts,.tsx --fix",
    "changelog": "auto-changelog -p",
    "release:check": "npm test -- --runInBand && npm run build && npm run lint && npm audit --omit=dev && npm pack --dry-run",
    "release:publish": "npm run release:check && npm publish --access public"
  },
  "files": [
    "dist/**/*",
    "!dist/tests/**/*"
  ],
  "author": "Iyobo Eki",
  "license": "MIT",
  "dependencies": {
    "@hapi/boom": "^10.0.1",
    "@koa/cors": "^5.0.0",
    "@koa/router": "^12.0.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.4",
    "helmet": "^8.3.0",
    "koa": "^2.16.4",
    "koa-body": "^4.2.0",
    "koa-helmet": "^9.0.0",
    "koa2-swagger-ui": "^5.12.0",
    "lodash": "^4.18.1",
    "openapi-types": "^12.1.3",
    "reflect-metadata": "^0.2.2"
  },
  "devDependencies": {
    "@koa/multer": "^4.0.0",
    "@types/boom": "^7.3.0",
    "@types/cookies": "^0.9.2",
    "@types/express": "^4.17.25",
    "@types/jest": "^30.0.0",
    "@types/koa": "^2.15.0",
    "@types/koa__cors": "^5.0.1",
    "@types/koa__router": "^12.0.3",
    "@types/lodash": "^4.14.149",
    "@types/node": "^18.19.130",
    "@types/supertest": "^7.2.0",
    "@typescript-eslint/eslint-plugin": "8.55.0",
    "@typescript-eslint/parser": "8.55.0",
    "auto-changelog": "^2.4.0",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-config-standard": "^17.1.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-n": "^18.3.0",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-promise": "^6.6.0",
    "eslint-plugin-react": "^7.37.5",
    "jest": "^30.5.1",
    "multer": "^2.3.0",
    "prettier": "^3.9.6",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.12",
    "ts-morph": "^13.0.3",
    "ts-node": "^10.9.1",
    "typescript": "^5.9.3"
  }
}
